#!/bin/bash
set -euo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
[[ "${3:-/}" = / ]] || { echo '仅支持安装到当前启动磁盘'; exit 1; }
[[ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || true)" = 1 ]] || { echo '此安装包仅支持 Apple Silicon Mac'; exit 1; }
OS_VERSION=$(/usr/bin/sw_vers -productVersion)
OS_MAJOR=${OS_VERSION%%.*}
[[ "$OS_MAJOR" = 15 || "$OS_MAJOR" = 26 ]] || { echo '此版本仅面向 macOS 15.x 与 26.x'; exit 1; }
[[ ! -L /Applications/Cellmori.app ]] || { echo '应用安装位置不能为符号链接'; exit 1; }
if [[ -e /Applications/Cellmori.app ]]; then
  EXISTING_ID=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' /Applications/Cellmori.app/Contents/Info.plist 2>/dev/null || true)
  [[ "$EXISTING_ID" = io.cellmori.app ]] || { echo '安装位置存在其他应用，停止覆盖'; exit 1; }
fi
